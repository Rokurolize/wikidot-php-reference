{"id": "x-bib-def-order", "source": "[[bibliography]]\n: alpha : Alpha text\n: beta : Beta text\n: gamma : Gamma text\n[[/bibliography]]\nCite ((bibcite gamma)) and ((bibcite alpha)).\n"}
{"id": "x-bib-unordered-labels", "source": "[[bibliography]]\n: zeta : Zeta text\n: alpha : Alpha text\n: mu : Mu text\n[[/bibliography]]\nCite ((bibcite mu)) and ((bibcite zeta)).\n"}
{"id": "x-bib-cite-before", "source": "Cite ((bibcite gamma)) then ((bibcite alpha)) then ((bibcite beta)).\n[[bibliography]]\n: alpha : Alpha text\n: beta : Beta text\n: gamma : Gamma text\n[[/bibliography]]\n"}
{"id": "x-bib-cite-after", "source": "[[bibliography]]\n: alpha : Alpha text\n: beta : Beta text\n[[/bibliography]]\nCite ((bibcite beta)) then ((bibcite alpha)).\n"}
{"id": "x-bib-dup-label", "source": "[[bibliography]]\n: k : First k\n: k : Second k\n[[/bibliography]]\nCite ((bibcite k)).\n"}
{"id": "x-bib-undefined", "source": "Cite ((bibcite missing)) with no such entry.\n[[bibliography]]\n: k : A real entry\n[[/bibliography]]\n"}
{"id": "x-bib-multi-block", "source": "[[bibliography]]\n: a : Entry A\n[[/bibliography]]\nBetween.\n[[bibliography]]\n: b : Entry B\n[[/bibliography]]\nCite ((bibcite a)) and ((bibcite b)).\n"}
{"id": "x-bib-title", "source": "[[bibliography title=\"References\"]]\n: k : Entry text\n[[/bibliography]]\nCite ((bibcite k)).\n"}
