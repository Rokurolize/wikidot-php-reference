 "x-bib-def-order": {
  "fullname": "muse-probe-r2notes-x-x-bib-def-order",
  "html": "<div class=\"bibitems\">\n<div class=\"title\">Bibliography</div>\n<div class=\"bibitem\" id=\"bibitem-1\">1. Alpha text</div>\n<div class=\"bibitem\" id=\"bibitem-2\">2. Beta text</div>\n<div class=\"bibitem\" id=\"bibitem-3\">3. Gamma text</div>\n</div>\n<p>Cite <a href=\"javascript:;\" class=\"bibcite\" id=\"bibcite-3-87094a\" onclick=\"WIKIDOT.page.utils.scrollToReference('bibitem-3')\">3</a> and <a href=\"javascript:;\" class=\"bibcite\" id=\"bibcite-1-24031a\" onclick=\"WIKIDOT.page.utils.scrollToReference('bibitem-1')\">1</a>.</p>",
